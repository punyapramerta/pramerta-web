# Salin file ini menjadi .env.local dan isi nilainya

# Supabase — dapatkan dari: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin Panel Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password

# Google Analytics 4
# Dapatkan dari: https://analytics.google.com → Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification Token
# Dapatkan dari: https://search.google.com/search-console → Add Property → HTML tag → content="..."
NEXT_PUBLIC_GSC_VERIFICATION=your_gsc_verification_token

# Google Gemini AI Key & Model
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash


# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_token
TELEGRAM_ADMIN_PIN=pramerta2026
NEXT_PUBLIC_SITE_URL=https://pramerta.com


